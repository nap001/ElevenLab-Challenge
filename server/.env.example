# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real secrets.
# (For Docker, use the root .env.example instead.)

PORT=3001

# ElevenLabs
AGENT_ID=your-elevenlabs-agent-id
XI_API_KEY=your-elevenlabs-api-key

# Google Gemini (AI Studio free key)
GEMINI_API_KEY=your-gemini-api-key
# Optional: override the default model (defaults to gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Allowed client origins (comma-separated, no trailing slash)
# Example for production: https://myapp.com
ALLOWED_ORIGIN=http://localhost:5173

# Firebase Admin: either save the key file as server/service-account.json (local dev),
# or — production/Docker — paste its contents as a single-line JSON string:
# GOOGLE_CREDENTIALS_JSON='{"type":"service_account",...}'
