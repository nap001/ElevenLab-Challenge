# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real secrets.

PORT=3001

# ElevenLabs
AGENT_ID=
XI_API_KEY=

# Google Gemini (AI Studio free key)
GEMINI_API_KEY=

# Allowed client origins (comma-separated, no trailing slash)
# Example for production: https://myapp.com
ALLOWED_ORIGIN=http://localhost:5173

# Production only: paste the contents of service-account.json as a single-line JSON string
# GOOGLE_CREDENTIALS_JSON=
