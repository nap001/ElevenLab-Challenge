# Copy to `.env` (git-ignored) and fill in real values. Used by `docker compose`.
# Never commit real secrets. For non-Docker local dev see server/.env.example
# and client/.env.local.example.

# ─── Backend (runtime secrets, injected into the backend container) ──────────

# ElevenLabs Conversational AI — https://elevenlabs.io
AGENT_ID=your-elevenlabs-agent-id
XI_API_KEY=your-elevenlabs-api-key

# Google Gemini (AI Studio) — https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Optional: override the default model (defaults to gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Firebase Admin service account, as ONE line of JSON wrapped in single quotes.
# Generate it from the downloaded key file with:
#   node -p "JSON.stringify(require('./server/service-account.json'))"
GOOGLE_CREDENTIALS_JSON='{"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@your-project-id.iam.gserviceaccount.com","client_id":"..."}'

# Origin(s) the browser loads the frontend from, comma-separated, no trailing slash.
# Docker default serves the frontend on :8080 (use http://localhost:5173 for `npm run dev`).
ALLOWED_ORIGIN=http://localhost:8080

# ─── Frontend (public web config, baked into the bundle at build time) ───────
# Firebase Console → Project Settings → Your apps → Web app

# URL the BROWSER uses to reach the backend.
VITE_API_URL=http://localhost:3001
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
